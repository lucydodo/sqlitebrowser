            <!-- French -->
            <ComponentRef Id="qt_fr.qm" />
            <ComponentRef Id="qtbase_fr.qm" />
            <ComponentRef Id="qtmultimedia_fr.qm" />
            <?if $(var.QtMajor)="5"?>
