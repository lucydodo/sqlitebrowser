                <ComponentRef Id="qtxmlpatterns_cs.qm" />
            <?endif?>

            <!-- English (United Kingdom) -->
            <ComponentRef Id="qt_en.qm" />
            <ComponentRef Id="qtbase_en.qm" />
            <ComponentRef Id="qtmultimedia_en.qm" />
            <?if $(var.QtMajor)="5"?>
